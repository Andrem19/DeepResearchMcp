# DeepResearch MCP Server Configuration
# Copy this file to .env and fill in your values.

# --- Server ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_BEARER_TOKEN=                  # Required for production, optional for local dev

# --- Search Provider ---
SEARCH_PROVIDER=fake                # fake | brave | tavily | serper
BRAVE_API_KEY=                      # Required if SEARCH_PROVIDER=brave
TAVILY_API_KEY=                     # Required if SEARCH_PROVIDER=tavily
SERPER_API_KEY=                     # Required if SEARCH_PROVIDER=serper

# --- LLM Provider ---
LLM_PROVIDER=extractive             # extractive | openai
LLM_API_KEY=                        # Required if LLM_PROVIDER=openai
LLM_API_BASE=                       # Optional: custom OpenAI-compatible endpoint
LLM_MODEL=                          # Optional: model name

# --- Limits ---
MAX_SOURCES_DEFAULT=8
MAX_SOURCES_HARD_LIMIT=20
FETCH_TIMEOUT_SECONDS=10
TOTAL_RESEARCH_TIMEOUT_SECONDS=60
MAX_FETCH_BYTES=1000000
CACHE_PATH=.cache/deepresearch.sqlite3

# --- Logging ---
LOG_LEVEL=INFO
